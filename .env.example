NODE_ENV=development
PORT=3000
HOST=127.0.0.1
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
MCP_ALLOWED_ORIGINS=http://localhost:6274
MCP_PUBLIC_BASE_URL=
MCP_AUTH_MODE=static
# Obrigatório com MCP_AUTH_MODE=static; mínimo de 32 caracteres.
MCP_BEARER_TOKEN=

# Produção com MCP_AUTH_MODE=oidc.
OIDC_ISSUER=
# Use OIDC_AUDIENCE apenas com IdP que implementa RFC 8707 e emite `aud` no
# access token. O Amazon Cognito NÃO emite `aud` em access token: nesse caso
# deixe OIDC_AUDIENCE vazio e preencha OIDC_ALLOWED_CLIENT_IDS com o client ID
# do app client, que passa a ser o vínculo do token com este recurso.
OIDC_AUDIENCE=
OIDC_ALLOWED_CLIENT_IDS=
OIDC_JWKS_URL=
OIDC_SCOPE_PREFIX=
OIDC_TENANT_CLAIM=
# true publica /.well-known/oauth-authorization-server com PKCE S256 e aponta o
# recurso protegido para este servidor. Necessário com o Amazon Cognito, que
# executa PKCE mas não o declara — e clientes MCP aderentes recusam quem não declara.
OIDC_METADATA_FACADE=false

MCP_REQUEST_STATE_KEY=
MCP_MAX_BODY_BYTES=2097152
MCP_UPLOAD_TTL_MS=600000
MCP_REQUESTS_PER_MINUTE=120
MCP_UPLOADS_PER_MINUTE=20
# Limite por IP antes da autenticação, contra flood com tokens inválidos.
MCP_ANONYMOUS_REQUESTS_PER_MINUTE=60
# Prazo de drenagem no SIGTERM; mantenha abaixo do StopTimeout da task ECS.
MCP_SHUTDOWN_GRACE_MS=20000

# Local: environment/memory. Produção AWS: Secrets Manager, Redis e S3.
D4SIGN_CREDENTIAL_BACKEND=environment
D4SIGN_CREDENTIAL_SCOPE=principal
# TTL do cache local de credenciais. A invalidação entre tasks é imediata via
# geração compartilhada no Redis; este TTL é só o limite superior.
D4SIGN_CREDENTIAL_CACHE_TTL_MS=30000
MCP_STATE_BACKEND=memory
MCP_UPLOAD_BACKEND=memory

AWS_REGION=
AWS_CREDENTIALS_SECRET_PREFIX=d4sign-mcp/credentials
AWS_CREDENTIALS_KMS_KEY_ID=
AWS_REDIS_URL=
AWS_REDIS_USERNAME=
AWS_REDIS_PASSWORD=
AWS_S3_BUCKET=
AWS_S3_PREFIX=uploads
# Produção: bloqueia o handle até o GuardDuty marcar NO_THREATS_FOUND.
AWS_S3_REQUIRE_CLEAN_SCAN=false

D4SIGN_ENVIRONMENT=sandbox
D4SIGN_TOKEN_API=
D4SIGN_CRYPT_KEY=
D4SIGN_REQUESTS_PER_HOUR=1000
D4SIGN_TIMEOUT_MS=15000
D4SIGN_MAX_RESPONSE_BYTES=2097152
D4SIGN_MAX_UPLOAD_BYTES=10485760

LOG_LEVEL=info
