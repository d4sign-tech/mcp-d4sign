{
  "name": "d4sign-mcp",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Servidor MCP stateless com o catálogo de 42 operações da API D4Sign.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev:http": "tsx src/index.ts http",
    "dev:stdio": "tsx src/index.ts stdio",
    "start": "node dist/src/index.js http",
    "start:stdio": "node dist/src/index.js stdio",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@aws-sdk/client-secrets-manager": "^3.1111.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "jose": "^6.2.8",
    "pino": "10.3.1",
    "redis": "^6.2.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "24.13.3",
    "eslint": "10.8.0",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.11"
  },
  "overrides": {
    "@hono/node-server": "2.0.12"
  }
}
